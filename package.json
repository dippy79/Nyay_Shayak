{
  "name": "legis-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm -w apps/frontend run dev",
    "build": "npm -w apps/frontend run build",
    "lint": "npm -w apps/frontend run lint",
    "typecheck": "npm -w apps/frontend run lint",
    "test": "jest --testPathPattern=tests/ --passWithNoTests",
    "test:py": "pytest tests/crawler.test.py -v"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11"
  }
}
