{
  "name": "legis-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"npm -w apps/backend run dev\" \"npm -w apps/frontend run dev\"",
    "build": "npm -w apps/frontend run build",
    "lint": "npm -w apps/frontend run lint",
    "typecheck": "npm -w apps/frontend run lint",
    "test": "jest --config jest.config.cjs --testPathPatterns=tests/ --passWithNoTests",
    "test:py": "pytest tests/test_crawler.py -v"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.0",
    "concurrently": "^9.1.2",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.4.2",
    "node-cron": "^4.2.1",
    "p-retry": "^8.0.0",
    "razorpay": "^2.9.6"
  }
}
